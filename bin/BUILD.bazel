load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":defs.bzl", "rootfs_binary")
load(":macros.bzl", "sh_binary_and_test")

package(default_visibility = ["//visibility:public"])

sh_binary_and_test(
    name = "ghdl",
    binary_cmd = "/usr/bin/ghdl-mcode",
)

sh_binary_and_test(
    name = "proot",
)


# A generic rootfs based binary runner.
sh_binary(
    name = "run",
    srcs = ["run.sh"],
    data = [
        "//image:rootfs",
        "@bazel_tools//tools/bash/runfiles",
        "@multitool//tools/gotopt2",
        "@rules_shell//shell/runfiles",
    ],
)

exports_files(["runner.sh.tpl"])

# The known resource environment is defined inside runner.sh.tpl, so that the
# code under test is the code that ships. The test extracts the marked block
# out of the template and sources it.
sh_test(
    name = "known_env_test",
    size = "small",
    srcs = ["known_env_test.sh"],
    args = ["$(rootpath runner.sh.tpl)"],
    data = ["runner.sh.tpl"],
)

# Proves rootfs_binary against this repository's own rootfs. A consumer builds
# a rootfs from its own manifest and points the same rule at that instead.
rootfs_binary(
    name = "ghdl_mcode",
    binary_path = "/usr/bin/ghdl-mcode",
    rootfs = "//image:rootfs",
)
